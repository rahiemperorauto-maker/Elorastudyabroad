# GEMINI_API_KEY: Optional for Gemini AI features
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000)
PORT="3000"

# SMTP Configuration for Contact Form email notifications:
# If left blank, the API gracefully alerts that SMTP credentials need configuration in production
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notifications@elorastudyaboard.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Elora Study Abroad <inquiries@elorastudyaboard.com>"
CONTACT_RECEIVER_EMAIL="admissions@elorastudyaboard.com"
